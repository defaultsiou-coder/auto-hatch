-- Draggable JS button
local dragging, dragStart, startPos
jsBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = jsBtn.Position
	end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		jsBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)
jsBtn.InputEnded:Connect(function() dragging = false end)

jsBtn.MouseButton1Click:Connect(function()
	local rayfield = player.PlayerGui:FindFirstChild("Rayfield") or game.CoreGui:FindFirstChild("Rayfield")
	if rayfield then rayfield.Enabled = not rayfield.Enabled end
end)

