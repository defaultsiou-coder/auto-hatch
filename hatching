-- Webhook Send Function
local function sendWebhook(petName, rarity)
	if not webhookEnabled or webhookURL == "" then return end
	local http_request = (syn and syn.request) or (request) or http_request
	if not http_request then return end

	pcall(function()
		http_request({
			Url = webhookURL,
			Method = "POST",
			Headers = {["content-type"] = "application/json"},
			Body = game:GetService("HttpService"):JSONEncode({
				content = pingEveryone and "@everyone" or "",
				embeds = {{
					title = "🎉 MYTHICAL+ PET HATCHED!",
					description = "**Pet:** " .. petName .. "\n**Rarity:** " .. rarity,
					color = 0xFF00FF,
					footer = {text = "Joana's Tap Sim Hub • " .. os.date("%X")},
				}}
			})
		})
	end)
end

